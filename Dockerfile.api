# The private API: runs the live pipeline on request. It reads ANTHROPIC_API_KEY from Secret Manager at run
# time; no key is ever written into the image.
FROM python:3.12-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1

WORKDIR /app

COPY pyproject.toml README.md ./
COPY src ./src
RUN pip install ".[api,agent,retrieval]"

# Policies load and their LCD quotes are checked when the service starts.
COPY policies ./policies

# COPY keeps each file's permissions from the machine that built the image; make everything readable.
RUN chmod -R a+rX /app

RUN useradd --create-home api
USER api

# Bake ChromaDB's embedding model into the image, so retrieval never downloads at run time.
RUN python -c "from chromadb.utils.embedding_functions import DefaultEmbeddingFunction as E; E()(['warm up'])"

# Cloud Run sets PORT, 8080 by default.
CMD ["sh", "-c", "exec uvicorn priorauth.api:app --host 0.0.0.0 --port ${PORT:-8080}"]
